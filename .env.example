APP_NAME=Cartotaxi
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cartotaxi
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

JWT_SECRET=
JWT_TTL_SECONDS=86400
FRONTEND_URL=http://localhost:3000
GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_ID=

# Sentry — paste the DSN from your Sentry project settings.
# Leave blank to disable Sentry entirely (the app boots fine without it).
SENTRY_LARAVEL_DSN=
# Override the auto-detected env tag in Sentry (defaults to APP_ENV).
SENTRY_ENVIRONMENT=
# Performance tracing sample rate, 0.0–1.0. 0.0 = trace nothing,
# 0.1 = trace 10% of requests, 1.0 = trace everything (expensive).
SENTRY_TRACES_SAMPLE_RATE=0.0
# Whether to attach the authenticated user to events. Off by default for
# privacy; set to true if your Sentry plan + DPA allows it.
SENTRY_SEND_DEFAULT_PII=false

FIREBASE_API_KEY=

CURRENCY=EUR
CURRENCY_SYMBOL=€

# Card payments (User app Stripe flow)
STRIPE_KEY=
STRIPE_SECRET=

# Sign in with Apple audience check (iOS bundle id)
APPLE_CLIENT_ID=
